{
  "manifest_version": 3,
  "name": "Preuve Haine",
  "version": "1.2.0",
  "description": "Archive des preuves de commentaires haineux et prépare leur signalement aux autorités.",
  "permissions": ["contextMenus", "activeTab", "scripting", "storage", "unlimitedStorage"],
  "host_permissions": ["https://api.anthropic.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "options_page": "options.html",
  "action": { "default_title": "Ouvrir le dossier de preuves" }
}
